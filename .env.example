# 复制这个文件为 .env，然后把下面的 key 替换成你自己的
# .env 文件已被 .gitignore 排除，不会上传到 GitHub

# --- AI 模型密钥（至少配一个）----------------------------------------------
# DeepSeek（首选）：获取地址 https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-api-key-here

# 通义千问（fallback）：获取地址 https://dashscope.console.aliyun.com/
QWEN_API_KEY=sk-your-qwen-key-here
# QWEN_MODEL=qwen-plus
# QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# --- Flask 安全配置（可选，但生产部署建议设置）------------------------------
# 1) FLASK_SECRET：用于签名 session 和 CSRF token。
#    不设置时每次启动随机生成（开发/演示 OK），部署到多进程/容器/重启后会失效，建议设固定值。
#    生成方法：python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET=your-64-char-random-string-here

# 2) FLASK_HOST：Flask 绑定的网络接口。默认 127.0.0.1（只有本机能访问）。
#    需要局域网/公网访问时显式设 0.0.0.0（同时注意防火墙和 CSRF/认证保护）。
FLASK_HOST=127.0.0.1

# 3) FLASK_PORT：监听端口。默认 5000。
# FLASK_PORT=5000

# 4) DB_PATH：SQLite 数据库路径。默认项目根目录 data.db。
#    Docker 部署用它把数据库指到挂载目录（docker-compose.yml 已内置，无需手动设置）。
# DB_PATH=

# 5) COLLECT_TOKEN：采集口令（可选）。默认空（不启用，任何人都能触发采集）。
#    设置非空值后，/collect 接口要求 POST 表单中带相同 token 字段，
#    用于防止演示/教学场景下被误操作清空已有数据。
#    例：COLLECT_TOKEN=my-secret-collect-pass
# COLLECT_TOKEN=
